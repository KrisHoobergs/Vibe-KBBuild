# ---------------------------------------------------------------------------
# Welke backend deze installatie gebruikt (alleen server-side).
# Standaard: de oorspronkelijke Supabase-installatie.
#
# Twee soorten installaties:
#   A. Supabase (zoals nu):   AUTH_DRIVER=supabase, STORAGE_DRIVER=supabase
#   B. Eigen database:        AUTH_DRIVER=local, STORAGE_DRIVER=database of filesystem
#      (gewone PostgreSQL, of SQL Server met DB_DIALECT=mssql). Eerst
#      `npm run db:migrate`, of DB_AUTO_MIGRATE=true. De eerste gebruiker die
#      zich registreert, wordt beheerder.
# Uitleg per soort installatie: docs/installatie.md.
# ---------------------------------------------------------------------------
DB_DIALECT=postgres          # postgres | mssql (SQL Server: zie het blok MSSQL_* hieronder)
AUTH_DRIVER=supabase         # supabase | local
STORAGE_DRIVER=supabase      # supabase | database | filesystem

# Directe databaseverbinding (Kysely). Supabase: Connect → "Transaction pooler"
# (poort 6543) voor Vercel. Geen ?sslmode in de URL: TLS stel je in met
# DATABASE_SSL (verify | no-verify | off; standaard no-verify, localhost: off).
# Lokaal ontwikkelen: de testkopie van `npm run db:lokaal`.
DATABASE_URL=postgres://postgres:lokaal@localhost:54329/kbbuild
# DATABASE_POOL_MAX=5
# DATABASE_SSL=no-verify
# DATABASE_SSL_CA=          # PEM of base64, alleen voor DATABASE_SSL=verify

# --- Alleen bij SQL Server (DB_DIALECT=mssql) ---------------------------------
# Alleen gelezen bij DB_DIALECT=mssql; DATABASE_URL en DATABASE_SSL tellen dan
# niet. Alleen zelf gehost (niet op Vercel), met AUTH_DRIVER=local.
# Uitleg en de volledige tabel: docs/installatie.md, deel E.
# MSSQL_SERVER=localhost             # zoals in SSMS: sqlsrv01, sqlsrv01,1433, sqlsrv01\SQLEXPRESS
# MSSQL_PORT=1433                    # standaard 1433; niet samen met een instantienaam
# MSSQL_INSTANCE=                    # instantienaam in plaats van een poort (vraagt SQL Server Browser)
# MSSQL_DATABASE=kennisbank
# MSSQL_AUTH=sql                     # sql | ntlm (Windows-account met wachtwoord) | azure-default (niet getest)
# MSSQL_USER=kennisbank              # bij ntlm mag dat DOMEIN\naam zijn
# MSSQL_PASSWORD=
# MSSQL_DOMAIN=                      # alleen bij ntlm, als MSSQL_USER geen DOMEIN\ bevat
# MSSQL_AZURE_CLIENT_ID=             # alleen bij azure-default (user-assigned managed identity)
# MSSQL_ENCRYPT=true                 # true | strict (SQL Server 2022+, Azure) | false (alleen localhost)
# MSSQL_TRUST_SERVER_CERT=true       # standaard true (certificaat niet gecontroleerd), false met MSSQL_CA, MSSQL_TLS_SERVERNAME of strict
# MSSQL_CA=                          # PEM of base64: CA om het certificaat van SQL Server te controleren
# MSSQL_TLS_SERVERNAME=              # naam in het certificaat (via IP-adres of alias); zet de controle aan
# Ook DATABASE_POOL_MAX (hierboven) geldt voor SQL Server.

# --- Alleen bij A (Supabase): login en bestandsopslag -----------------------
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Alleen bij B (eigen database) -------------------------------------------
# Publiek adres van deze installatie (zonder / op het einde).
# SITE_URL=https://kennis.voorbeeld.be
# Geheime sleutel voor sessies en upload-tickets, minstens 32 tekens:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# BETTER_AUTH_SECRET=
# Registreren: "uitnodiging" (alleen met een uitnodigingslink; aanbevolen) of "open".
# REGISTRATIE=uitnodiging
# Bij STORAGE_DRIVER=filesystem: map voor geüploade bestanden (blijvend en
# beschrijfbaar; niet op Vercel). Bij "database" staan bestanden in de tabel files.
# STORAGE_DIR=/var/lib/kennisbank/bestanden
# Migraties automatisch bij het opstarten (nooit bij Supabase):
# DB_AUTO_MIGRATE=true
# Achter een reverse proxy: die moet X-Forwarded-For zetten (begrenzing van
# inlogpogingen per IP).

# 32 willekeurige bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Lokaal en in Vercel dezelfde waarde gebruiken (zelfde data).
MAIL_ENCRYPTION_KEY=your-base64-32-byte-key-here

# Alleen voor scripts op je eigen pc (nooit in Vercel):
# npm run db:backup leest productie ALLEEN-LEZEN via de "Session pooler" (poort 5432).
# PROD_DATABASE_URL=postgresql://postgres.<ref>:<wachtwoord>@aws-1-eu-north-1.pooler.supabase.com:5432/postgres

# Alleen voor de SQL Server-testscripts (npm run db:test:mssql, db:test:migraties:mssql,
# test:login:mssql, test:fulltext:mssql, db:mssql:controle -- --test). Altijd MSSQL_TEST_*,
# nooit MSSQL_*: de scripts zetten MSSQL_TEST_X om naar MSSQL_X en wissen al de rest.
# De naam van de database moet passen bij ^(kb|kennisbank)_(test|pariteit), EN de database
# moet de markering kb_testdatabase = 'ja' hebben (scripts/mssql/testdatabase.sql). LET OP: db:test:migraties:mssql en
# test:login:mssql maken die database helemaal leeg.
# MSSQL_TEST_SERVER=
# MSSQL_TEST_PORT=1433
# MSSQL_TEST_DATABASE=kb_test
# MSSQL_TEST_USER=
# MSSQL_TEST_PASSWORD=
# MSSQL_TEST_ENCRYPT=true
# MSSQL_TEST_TRUST_SERVER_CERT=true
# Optioneel: MSSQL_TEST_BEHEERDER_USER / _PASSWORD (sysadmin, voor sys.dm_fts_parser in
# test:fulltext:mssql), MSSQL_TEST_FULLTEXT_VERWACHT=1|0, MSSQL_TEST_STEMMER_VERWACHT=0.
