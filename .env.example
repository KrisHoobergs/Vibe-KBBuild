# ---------------------------------------------------------------------------
# Welke backend deze installatie gebruikt (alleen server-side).
# Standaard: de oorspronkelijke Supabase-installatie.
# ---------------------------------------------------------------------------
DB_DIALECT=postgres          # postgres (SQL Server volgt later)
AUTH_DRIVER=supabase         # supabase (eigen login volgt later)
STORAGE_DRIVER=supabase      # supabase (database/map volgen later)

# Directe databaseverbinding (Kysely). Supabase: Connect → "Transaction pooler"
# (poort 6543) voor Vercel. Geen ?sslmode in de URL: TLS stel je in met
# DATABASE_SSL (verify | no-verify | off; standaard no-verify, localhost: off).
# Lokaal ontwikkelen: de testkopie van `npm run db:lokaal`.
DATABASE_URL=postgres://postgres:lokaal@localhost:54329/kbbuild
# DATABASE_POOL_MAX=5
# DATABASE_SSL=no-verify
# DATABASE_SSL_CA=          # PEM of base64, alleen voor DATABASE_SSL=verify

# Supabase (login en bestandsopslag)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 32 willekeurige bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Lokaal en in Vercel dezelfde waarde gebruiken (zelfde data).
MAIL_ENCRYPTION_KEY=your-base64-32-byte-key-here

# Alleen voor scripts op je eigen pc (nooit in Vercel):
# npm run db:backup leest productie ALLEEN-LEZEN via de "Session pooler" (poort 5432).
# PROD_DATABASE_URL=postgresql://postgres.<ref>:<wachtwoord>@aws-1-eu-north-1.pooler.supabase.com:5432/postgres
