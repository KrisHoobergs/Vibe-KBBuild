# Instellingen voor docker-compose.yml. Kopieer naar .env (zelfde map) en vul in.
# .env bevat geheimen: nooit committen of delen.

# Wachtwoord van de database-gebruiker (alleen binnen Docker gebruikt).
POSTGRES_PASSWORD=

# Het adres waarop gebruikers de kennisbank openen, zonder / op het einde.
# Achter een reverse proxy met HTTPS: het https-adres.
SITE_URL=http://localhost:3000

# Geheime sleutels: elk een nieuwe, willekeurige waarde.
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
BETTER_AUTH_SECRET=
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAIL_ENCRYPTION_KEY=

# Optioneel
# POORT=3000                   # poort op de server
# STORAGE_DRIVER=filesystem    # of: database (bestanden in PostgreSQL)
# REGISTRATIE=uitnodiging      # of: open
