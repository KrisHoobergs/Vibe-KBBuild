# Instellingen voor docker-compose.mssql.yml (kennisbank met SQL Server).
# Kopieer naar .env (zelfde map) en vul in.
# .env bevat geheimen: nooit committen of delen, wel veilig bewaren (back-up).
#
# Waarden maken zonder Node op de server: met openssl (Linux, Git Bash) of
#   docker run --rm node:24-slim node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Wachtwoorden voor SQL Server (alleen binnen Docker gebruikt). Regels van SQL
# Server: minstens 8 tekens, met hoofdletters, kleine letters en cijfers (of
# tekens). Gebruik geen ' of " (komt letterlijk in het SQL-script). Bv.:
#   echo "Kb1-$(openssl rand -hex 16)"
#
# Beheerder (sa): geldt vanaf de eerste start; later hier wijzigen verandert
# het wachtwoord in SQL Server niet meer.
MSSQL_SA_PASSWORD=
# Login van de app (kennisbank, alleen rechten in de eigen database). Wordt bij
# elke start opnieuw gezet: hier wijzigen en opnieuw starten volstaat.
MSSQL_APP_PASSWORD=

# Editie: Express (gratis, ook voor productie), Standard of Enterprise (met
# productsleutel in de plaats van de naam). Developer mag niet voor productie.
MSSQL_PID=Express

# Het adres waarop gebruikers de kennisbank openen, zonder / op het einde.
# Achter een reverse proxy met HTTPS: het https-adres. Registreer en log dan
# ook via dat adres in, niet via http://<server>:3000.
SITE_URL=http://localhost:3000

# Geheime sleutels: elk een nieuwe, willekeurige waarde.
#   openssl rand -base64 36
BETTER_AUTH_SECRET=
#   openssl rand -base64 32      (moet precies 32 bytes zijn)
MAIL_ENCRYPTION_KEY=

# Optioneel
# POORT=3000                   # poort op de server; achter een reverse proxy op
#                              # dezelfde server: POORT=127.0.0.1:3000
# STORAGE_DRIVER=filesystem    # of: database (bestanden in SQL Server; met Express
#                              # telt dat mee voor de maximale databasegrootte).
#                              # Kies dit vóór de eerste upload: later wisselen
#                              # zet bestaande bestanden niet over (ze geven dan 404).
# REGISTRATIE=uitnodiging      # of: open
# MSSQL_MEMORY_LIMIT_MB=2048   # geheugen voor SQL Server (minstens 2048)
