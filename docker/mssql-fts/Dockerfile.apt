# TERUGVALOPTIE, alleen als Dockerfile (uitgepakt FTS-pakket) in CI
# IsFullTextInstalled = 0 geeft. De klassieke weg van Microsoft: Ubuntu plus
# beide pakketten (mssql-server en mssql-server-fts) uit de apt-repository, in
# dezelfde, vaste versie. Groter en trager te bouwen, maar zo installeert
# Microsoft het zelf op Linux.
#
#   docker build -f docker/mssql-fts/Dockerfile.apt -t kennisbank-mssql:2025-fts docker/mssql-fts
#
# SQL Server 2022:
#   docker build -f docker/mssql-fts/Dockerfile.apt \
#     --build-arg UBUNTU=22.04 --build-arg MSSQL_REPO=mssql-server-2022 \
#     --build-arg MSSQL_VERSIE=16.0.4305.5-1 -t kennisbank-mssql:2022-fts docker/mssql-fts
ARG UBUNTU=24.04
FROM ubuntu:${UBUNTU}

ARG UBUNTU
ARG MSSQL_REPO=mssql-server-2025
ARG MSSQL_VERSIE=17.0.5015.4-1
ENV DEBIAN_FRONTEND=noninteractive \
    ACCEPT_EULA=Y \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/mssql-tools18/bin

# postinst van mssql-server maakt de systeemgebruiker mssql aan; de datamap
# (en de map voor back-ups) moet van die gebruiker zijn.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg; \
    . /etc/os-release; \
    curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg; \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/ubuntu/${UBUNTU}/${MSSQL_REPO} ${VERSION_CODENAME} main" > /etc/apt/sources.list.d/mssql-server.list; \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/ubuntu/${UBUNTU}/prod ${VERSION_CODENAME} main" > /etc/apt/sources.list.d/microsoft-prod.list; \
    apt-get update; \
    apt-get install -y "mssql-server=${MSSQL_VERSIE}" "mssql-server-fts=${MSSQL_VERSIE}" mssql-tools18 unixodbc; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p /var/opt/mssql/backup; \
    chown -R mssql:mssql /var/opt/mssql

USER mssql
EXPOSE 1433
CMD ["/opt/mssql/bin/sqlservr"]
